{PresetMetadata:{author:"Recast",category:"Фракции",description:"Посланник фракции: Движение «Пепельный Корень»",entityTypeId:"easy_npc:humanoid",name:"Голос Корня",variantType:"STEVE",version:"1.0.0"},data:{ActionData:{ActionPermissionLevel:4},CustomName:'{"color":"#00AA00","text":"Голос Корня"}',CustomNameVisible:1b,FactionName:"ash_root",DialogData:{DialogDataSet:[{Label:"default",Name:"Встреча",Texts:[{Text:"Земля помнит, кто её травил. О вас она пока молчит, @initiator."},{Text:"Мы не против машин. Мы против мёртвой воды, @initiator."},{Text:"Говорите. Только не о прибыли, @initiator."}],Buttons:[{Label:"about",Name:"Кто вы и чего хотите?",Actions:[{Cmd:"/execute as @initiator run if_threat faction ash_root",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}]},{Label:"talks",Name:"Поговорим о договоре.",Actions:[{Cmd:"talks",Type:"OPEN_NAMED_DIALOG"}]},{Label:"leave",Name:"Не сейчас.",Actions:[{Type:"CLOSE_DIALOG"}]}]},{Label:"talks",Name:"Переговоры",Texts:[{Text:"Договор — это обязательство обеих сторон. Мы предлагаем только то, на что вы уже заслужили право."}],Buttons:[{Label:"treaty_truce",Name:"Перемирие",Actions:[{Cmd:"/execute as @initiator run if_threat treaty sign ash_root truce",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Type:"SCOREBOARD",Name:"if_rep_05",Operation:"GREATER_THAN_OR_EQUALS",Value:-75},{Type:"SCOREBOARD",Name:"if_epoch",Operation:"GREATER_THAN_OR_EQUALS",Value:0}]},{Label:"treaty_trade",Name:"Торговый договор",Actions:[{Cmd:"/execute as @initiator run if_threat treaty sign ash_root trade",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Type:"SCOREBOARD",Name:"if_rep_05",Operation:"GREATER_THAN_OR_EQUALS",Value:-10},{Type:"SCOREBOARD",Name:"if_epoch",Operation:"GREATER_THAN_OR_EQUALS",Value:1}]},{Label:"treaty_tribute",Name:"Дань",Actions:[{Cmd:"/execute as @initiator run if_threat treaty sign ash_root tribute",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Type:"SCOREBOARD",Name:"if_rep_05",Operation:"GREATER_THAN_OR_EQUALS",Value