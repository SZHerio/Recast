{PresetMetadata:{author:"Recast",category:"Фракции",description:"Посланник фракции: Вольная артель «Шрам»",entityTypeId:"easy_npc:humanoid",name:"Переговорщик артели",variantType:"KNIGHT_01",version:"1.0.0"},data:{ActionData:{ActionPermissionLevel:4},CustomName:'{"color":"#FF5555","text":"Переговорщик артели"}',CustomNameVisible:1b,FactionName:"scar",DialogData:{DialogDataSet:[{Label:"default",Name:"Встреча",Texts:[{Text:"Живой. Пока. Чего хотел, @initiator?"},{Text:"У артели простое правило: платят — не трогаем. Ясно, @initiator?"},{Text:"Слушаю. Быстро, @initiator."}],Buttons:[{Label:"about",Name:"Кто вы и чего хотите?",Actions:[{Cmd:"/execute as @initiator run if_threat faction scar",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}]},{Label:"talks",Name:"Поговорим о договоре.",Actions:[{Cmd:"talks",Type:"OPEN_NAMED_DIALOG"}]},{Label:"leave",Name:"Не сейчас.",Actions:[{Type:"CLOSE_DIALOG"}]}]},{Label:"talks",Name:"Переговоры",Texts:[{Text:"Договор — это обязательство обеих сторон. Мы предлагаем только то, на что вы уже заслужили право."}],Buttons:[{Label:"treaty_truce",Name:"Перемирие",Actions:[{Cmd:"/execute as @initiator run if_threat treaty sign scar truce",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Type:"SCOREBOARD",Name:"if_rep_06",Operation:"GREATER_THAN_OR_EQUALS",Value:-75},{Type:"SCOREBOARD",Name:"if_epoch",Operation:"GREATER_THAN_OR_EQUALS",Value:0}]},{Label:"treaty_trade",Name:"Торговый договор",Actions:[{Cmd:"/execute as @initiator run if_threat treaty sign scar trade",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Type:"SCOREBOARD",Name:"if_rep_06",Operation:"GREATER_THAN_OR_EQUALS",Value:-10},{Type:"SCOREBOARD",Name:"if_epoch",Operation:"GREATER_THAN_OR_EQUALS",Value:1}]},{Label:"treaty_tribute",Name:"Дань",Actions:[{Cmd:"/execute as @initiator run if_threat treaty sign scar tribute",Type:"COMMAND"},{Type:"CLOSE_DIALOG"}],Conditions:[{Type:"SCOREBOARD",Name:"if_rep_06",Operation:"GREATER_THAN_OR_EQUALS",Value:-75},{Type:"SCOREBOARD",Name:"if_epoch