// Рецепты собственных машин сборки: как их построить и что они делают.
//
// Пять машин закрывают пять обещаний, которые до сих пор держались на тексте.
// Здесь у каждой появляется цена постройки и хотя бы один процесс, ради
// которого её строят.
//
// Цена контроллеров назначена по эпохе обещания, а не «на глаз»: водоочистка и
// пост контроля стоят MV, дезактивация — HV, стенд ступени — IV, станция роя —
// LuV. Так машина открывается ровно там, где сборка о ней рассказывает.
//
// Все ID сверены с живой переписью kubejs/exported/gtceu_item_census.json.
ServerEvents.recipes((event) => {
  // ----------------------------------------------------------------
  // Контроллеры
  // ----------------------------------------------------------------

  // Водоочистная станция, P4. Насос, фильтр и корпус MV — это уровень, на
  // котором город впервые требует питьевую воду отдельно от технической.
  event.shaped('gtceu:water_treatment_plant', [
    'PFP',
    'CHC',
    'PSP'
  ], {
    P: 'gtceu:steel_plate',
    F: 'gtceu:filter_casing',
    C: 'gtceu:mv_electric_pump',
    H: 'gtceu:mv_machine_hull',
    S: 'gtceu:mv_sensor'
  }).id('industrial_frontier:m85/machines/water_treatment_plant')

  // Установка дезактивации, P6. Свинец в рецепте не украшение: это тот же
  // материал, которым закрывают зону, и он должен быть виден в цене.
  event.shaped('gtceu:decontamination_unit', [
    'LFL',
    'PHP',
    'LSL'
  ], {
    L: 'gtceu:lead_plate',
    F: 'gtceu:filter_casing',
    P: 'gtceu:stainless_steel_plate',
    H: 'gtceu:hv_machine_hull',
    S: 'gtceu:hv_sensor'
  }).id('industrial_frontier:m85/machines/decontamination_unit')

  // Пост радиационного контроля, P6. Самая дешёвая из пяти: пост должен
  // стоять на каждом входе в зону, а не быть единственным на весь объект.
  event.shaped('gtceu:lv_radiation_checkpoint', [
    'PSP',
    'CHC',
    'PPP'
  ], {
    P: 'gtceu:steel_plate',
    S: 'gtceu:mv_sensor',
    C: 'gtceu:lead_plate',
    H: 'gtceu:lv_machine_hull'
  }).id('industrial_frontier:m85/machines/radiation_checkpoint')

  // Стенд сборки ступени, P7. Манипулятор IV — то же требование, что у входа
  // в стратегический домен: ступень собирает автоматика, а не рука игрока.
  event.shaped('gtceu:stage_assembly_stand', [
    'TRT',
    'AHA',
    'TCT'
  ], {
    T: 'gtceu:titanium_plate',
    R: 'gtceu:iv_robot_arm',
    A: 'gtceu:assembly_line_casing',
    H: 'gtceu:iv_machine_hull',
    C: 'gtceu:iv_sensor'
  }).id('industrial_frontier:m85/machines/stage_assembly_stand')

  // Станция обслуживания роя, P9. Дороже всех, и это правильно: она нужна
  // только тому, кто уже строит сферу.
  event.shaped('gtceu:swarm_service_station', [
    'PRP',
    'AHA',
    'PCP'
  ], {
    P: 'gtceu:high_power_casing',
    R: 'gtceu:luv_robot_arm',
    A: 'gtceu:advanced_computer_casing',
    H: 'gtceu:luv_machine_hull',
    C: 'gtceu:luv_sensor'
  }).id('industrial_frontier:m85/machines/swarm_service_station')

  // ----------------------------------------------------------------
  // Процессы
  // ----------------------------------------------------------------

  // Очистка воды. Три ступени, и каждая честно отдаёт осадок: правило M4
  // говорит, что воду нельзя очистить «в никуда», и здесь это видно в самом
  // рецепте, а не в примечании.
  //
  // Первая ступень: грубая очистка речной воды углём. Даёт техническую воду
  // и осадок.
  event.recipes.gtceu.water_treatment('industrial_frontier:m85/water/coarse')
    .itemInputs('gtceu:carbon_dust')
    .inputFluids(Fluid.of('minecraft:water', 1000))
    .outputFluids(Fluid.of('gtceu:distilled_water', 600))
    .itemOutputs('2x minecraft:clay_ball')
    .duration(120)
    .EUt(24)

  // Вторая ступень: обеззараживание хлором. Выход выше, но появляется
  // химический сток, который придётся куда-то деть.
  event.recipes.gtceu.water_treatment('industrial_frontier:m85/water/chlorination')
    .itemInputs('gtceu:activated_carbon_dust')
    .inputFluids(Fluid.of('minecraft:water', 1000), Fluid.of('gtceu:chlorine', 50))
    .outputFluids(Fluid.of('gtceu:distilled_water', 900))
    .duration(100)
    .EUt(96)

  // ----------------------------------------------------------------

  // Дезактивация. Загрязнение снимается раствором и переходит в концентрат:
  // ровно то, что обещает регламент шестой эпохи. Отход не исчезает — он
  // становится компактнее и требует хранения.
  event.recipes.gtceu.decontamination('industrial_frontier:m85/decon/waste_concentration')
    .itemInputs('4x hbm_ntm_rebirth:nuclear_waste_tiny')
    .inputFluids(Fluid.of('gtceu:distilled_water', 1000))
    .itemOutputs('hbm_ntm_rebirth:nuclear_waste')
    .duration(200)
    .EUt(480)

  // ----------------------------------------------------------------

  // Радиационный замер. Предмет входит и выходит тем же: пост ничего не
  // производит. Он тратит энергию и время и отвечает на единственный вопрос —
  // можно ли это выносить из зоны.
  event.recipes.gtceu.radiation_survey('industrial_frontier:m85/survey/plutonium')
    .itemInputs('hbm_ntm_rebirth:ingot_plutonium')
    .itemOutputs('hbm_ntm_rebirth:ingot_plutonium')
    .duration(60)
    .EUt(16)

  event.recipes.gtceu.radiation_survey('industrial_frontier:m85/survey/waste')
    .itemInputs('hbm_ntm_rebirth:nuclear_waste')
    .itemOutputs('hbm_ntm_rebirth:nuclear_waste')
    .duration(60)
    .EUt(16)

  console.info(
    '[Recast] Собственные машины: пять контроллеров и шесть процессов зарегистрированы.'
  )
})
