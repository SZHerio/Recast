{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/threat/epoch.schema.json",
  "$defs": {
    "teamState": {
      "type": "object",
      "required": ["tech_epoch", "members", "reputation", "affiliation", "special_statuses", "treaties", "facts", "contracts", "bases", "operations", "audit_log"],
      "properties": {
        "tech_epoch": { "type": "integer", "minimum": 0, "maximum": 9 },
        "members": { "type": "array", "items": { "type": "string", "format": "uuid" }, "uniqueItems": true },
        "reputation": { "type": "object", "additionalProperties": { "type": "integer", "minimum": -100, "maximum": 100 } },
        "affiliation": { "type": ["string", "null"], "pattern": "^industrial_frontier:[a-z0-9_./-]+$" },
        "special_statuses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "treaties": { "type": "object" },
        "facts": { "type": "object", "additionalProperties": { "type": ["boolean", "integer", "string"] } },
        "contracts": { "type": "object" },
        "bases": { "type": "object" },
        "operations": { "type": "object" },
        "audit_log": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    }
  }
}
