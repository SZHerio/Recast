# Что здесь лежит и почему.
#
# В репозитории живёт авторская часть сборки: скрипты, конфигурации, квесты,
# реестры, документация и инструменты. Всё остальное либо принадлежит чужим
# модам, либо создаётся игрой заново, либо относится лично к владельцу.

# --- Чужие моды ---
# Папка mods/ намеренно НЕ исключена: решение владельца от 3 августа 2026 —
# архив с гита должен разворачиваться в рабочий экземпляр без ручной досборки.
# Репозиторий приватный, поэтому вопрос распространения чужих JAR не возникает.
# Дублирующая опись есть в manifest.json (113 модов с project/file ID) и в
# docs/registries/curseforge_sources.json: по ним модлист восстанавливается
# точь-в-точь, даже если папку однажды придётся вычистить из истории.

# Распакованный оружейный пак TACZ: 84 МБ ассетов, которые мод разворачивает
# сам при первом запуске. Без них игра не ломается, поэтому в репозитории их нет.
tacz/

# --- Личное владельца ---
# Имя, UUID и путь до профиля не должны уезжать в публичный репозиторий.
usercache.json
usernamecache.json
.curseclient
gtceu/
xaero/
XaeroWaypoints_BACKUP240807/
fancymenu_data/last_world.fmdata

# --- Создаётся игрой заново ---
saves/
backups/
logs/
crash-reports/
screenshots/
.pg-native/
local/
patchouli_data.json
rhino.local.properties
/options.txt
servers.dat
usernamecache.json.bak

# --- Клиентские папки, не относящиеся к сборке ---
/resourcepacks/
shaderpacks/

# --- Локальные артефакты статических проверок ---
/tmp/
# Отчёты инструментов пересобираются одной командой и в истории не нужны.
/build/
**/__pycache__/
*.pyc

# --- Инструменты разработки, не входящие в выпуск ---
# Дампы ProbeJS: 60 МБ описаний API, которые мод создаёт заново за один запуск.
.vscode/
disabled_mods/
