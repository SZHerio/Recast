{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/retired_ids.schema.json",
  "title": "Industrial Frontier retired engine ID registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "retired"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "namespace": {
      "const": "industrial_frontier"
    },
    "retired": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/retiredId"
      }
    }
  },
  "$defs": {
    "engineId": {
      "type": "string",
      "pattern": "^[0-9A-F]{16}$"
    },
    "retiredId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "kind",
        "old_alias",
        "retired_in",
        "migration_policy",
        "successor_alias",
        "reason_ru",
        "evidence"
      ],
      "properties": {
        "engine_id": {
          "$ref": "#/$defs/engineId"
        },
        "kind": {
          "enum": [
            "group",
            "chapter",
            "quest",
            "task",
            "reward"
          ]
        },
        "old_alias": {
          "type": "string",
          "minLength": 3
        },
        "parent_old_engine_id": {
          "$ref": "#/$defs/engineId"
        },
        "parent_old_alias": {
          "type": "string",
          "minLength": 3
        },
        "retired_in": {
          "const": "industrial_frontier:quest_source_v2"
        },
        "migration_policy": {
          "enum": [
            "review",
            "reset",
            "retire"
          ]
        },
        "successor_alias": {
          "type": "string",
          "pattern": "^if\\.(?:group|chapter|quest)\\.v2\\.[a-z0-9_.-]+$"
        },
        "reason_ru": {
          "type": "string",
          "minLength": 20
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "task",
                  "reward"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "parent_old_engine_id",
              "parent_old_alias"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parent_old_engine_id"
                  ]
                },
                {
                  "required": [
                    "parent_old_alias"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
