{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/m2_bypass_decisions.schema.json",
  "title": "Recast M2 bypass decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "registry_id",
    "status",
    "scope_ru",
    "decisions",
    "gates",
    "source_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "namespace": { "const": "industrial_frontier" },
    "registry_id": { "const": "industrial_frontier:m2/bypass_decisions" },
    "status": { "const": "STATIC_COMPLETE_USER_GATE_PENDING" },
    "scope_ru": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bypass_id",
          "category",
          "status",
          "risk_ru",
          "decision_ru",
          "source_refs",
          "target_refs",
          "enforcement",
          "profit_check",
          "related_decision_refs",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "bypass_id": {
            "type": "string",
            "pattern": "^industrial_frontier:bypass/[a-z0-9_/-]+$"
          },
          "category": { "enum": ["MATERIAL", "ENERGY", "WORLDGEN", "MACHINE", "RECIPE", "LOGISTICS"] },
          "status": {
            "enum": [
              "CLOSED_STATIC",
              "ACCEPTED_LIMITED",
              "OPEN_STATIC_AUDIT",
              "GATED_NOT_INSTALLED"
            ]
          },
          "risk_ru": { "type": "string", "minLength": 1 },
          "decision_ru": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "target_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "enforcement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "implementation_refs", "expected_state_ru"],
            "properties": {
              "mode": {
                "enum": [
                  "CONFIG",
                  "TAG_POLICY",
                  "RECIPE_POLICY",
                  "DEDICATED_ONE_WAY_ENDPOINT",
                  "GATE_ONLY"
                ]
              },
              "implementation_refs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "expected_state_ru": { "type": "string", "minLength": 1 }
            }
          },
          "profit_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_gain", "energy_cycle", "static_result"],
            "properties": {
              "material_gain": { "enum": ["NONE_EXPECTED", "POSSIBLE", "NOT_APPLICABLE", "UNKNOWN"] },
              "energy_cycle": { "enum": ["NONE_EXPECTED", "POSSIBLE", "NOT_APPLICABLE", "UNKNOWN"] },
              "static_result": { "enum": ["PASS", "OPEN", "BLOCKED_NOT_INSTALLED"] }
            }
          },
          "related_decision_refs": {
            "type": "array",
            "items": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
            "uniqueItems": true
          },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "m2_common.schema.json#/$defs/gate" }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "m2_common.schema.json#/$defs/sourceEvidence" }
    }
  }
}
