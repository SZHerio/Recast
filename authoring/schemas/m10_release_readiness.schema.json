{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/m10_release_readiness.schema.json",
  "title": "Recast M10 release-readiness ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "registry_id",
    "milestone",
    "build_id",
    "status",
    "release_ready",
    "no_game_launch",
    "translation_stream",
    "gates",
    "blockers",
    "release_contract"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "registry_id": { "const": "industrial_frontier:m10/release_readiness" },
    "milestone": { "const": "M10" },
    "build_id": { "const": "IF-M10-0001" },
    "status": {
      "enum": [
        "STATIC_IMPLEMENTED_GATES_OPEN",
        "RELEASE_CANDIDATE",
        "RELEASE_READY"
      ]
    },
    "release_ready": { "type": "boolean" },
    "no_game_launch": { "const": true },
    "translation_stream": { "$ref": "#/$defs/translationStream" },
    "gates": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/gate" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "release_contract": { "$ref": "#/$defs/releaseContract" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "translationStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "release_blocking",
        "owner",
        "protected_patterns",
        "note_ru"
      ],
      "properties": {
        "mode": { "const": "LOCALIZATION_MERGED_AND_STATICALLY_AUDITED" },
        "status": { "const": "DONE" },
        "release_blocking": { "const": false },
        "owner": { "const": "CODEX" },
        "protected_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "note_ru": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title_ru",
        "status",
        "owner",
        "release_blocking",
        "evidence",
        "note_ru"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^M10-(0[1-9]|1[0-4])$" },
        "title_ru": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["DONE", "PARTIAL", "NOT_DONE", "DEFERRED", "OWNER"]
        },
        "owner": { "enum": ["CODEX", "OWNER", "EXTERNAL", "SHARED"] },
        "release_blocking": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "note_ru": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "resolution_owner",
        "evidence",
        "note_ru"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^M10-BLK-[0-9]{3}$" },
        "kind": {
          "enum": [
            "SOURCE_POLICY",
            "LOCALIZATION",
            "RUNTIME_EVIDENCE",
            "EDITORIAL_REVIEW"
          ]
        },
        "status": { "enum": ["OPEN", "RESOLVED"] },
        "resolution_owner": { "enum": ["CODEX", "OWNER", "EXTERNAL", "SHARED"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "note_ru": { "type": "string", "minLength": 1 }
      }
    },
    "releaseContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "source_registry_path",
        "audit_directory",
        "license_inventory_path",
        "release_profiles_path",
        "required_public_archive_roots",
        "forbidden_public_archive_patterns"
      ],
      "properties": {
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "source_registry_path": { "$ref": "#/$defs/relativePath" },
        "audit_directory": { "$ref": "#/$defs/relativePath" },
        "license_inventory_path": { "$ref": "#/$defs/relativePath" },
        "release_profiles_path": { "$ref": "#/$defs/relativePath" },
        "required_public_archive_roots": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_public_archive_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
