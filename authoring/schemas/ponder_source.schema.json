{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/ponder_source.schema.json",
  "title": "Ponder scene design trace",
  "type": "object",
  "required": ["schema_version", "scene_id", "target_item", "script", "learning_objectives", "test_gate"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "scene_id": { "type": "string", "pattern": "^industrial_frontier:[a-z0-9_./-]+$" },
    "target_item": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "script": { "type": "string" },
    "learning_objectives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "test_gate": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
