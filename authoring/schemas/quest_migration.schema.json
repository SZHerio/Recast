{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/quest_migration.schema.json",
  "title": "Quest Source v1 to v2 completion migration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_kind",
    "schema_version",
    "migration_id",
    "from_book",
    "to_book",
    "mappings"
  ],
  "properties": {
    "source_kind": {
      "const": "quest_migration"
    },
    "schema_version": {
      "const": 2
    },
    "migration_id": {
      "type": "string",
      "pattern": "^industrial_frontier:quest_migration/[a-z0-9_.-]+$"
    },
    "from_book": {
      "const": "industrial_frontier:quest_source_v1"
    },
    "to_book": {
      "const": "industrial_frontier:quest_source_v2"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    }
  },
  "$defs": {
    "questId": {
      "type": "string",
      "pattern": "^3[0-9A-F]{15}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_alias",
        "old_engine_id",
        "new_alias",
        "new_engine_id",
        "policy",
        "reason",
        "evidence"
      ],
      "properties": {
        "old_alias": {
          "type": "string",
          "pattern": "^if\\.quest\\.[a-z0-9_.-]+$"
        },
        "old_runtime_alias": {
          "type": "string",
          "pattern": "^if\\.quest\\.[a-z0-9_.-]+$"
        },
        "old_engine_id": {
          "$ref": "#/$defs/questId"
        },
        "new_alias": {
          "type": "string",
          "pattern": "^if\\.quest\\.v2\\.[a-z0-9_.-]+$"
        },
        "new_engine_id": {
          "$ref": "#/$defs/questId"
        },
        "policy": {
          "enum": [
            "carry",
            "review",
            "reset"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 12
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
