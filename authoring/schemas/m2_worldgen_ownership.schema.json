{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/m2_worldgen_ownership.schema.json",
  "title": "Recast M2 worldgen ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "registry_id",
    "status",
    "scope_ru",
    "ownership_decisions",
    "gates",
    "source_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "namespace": { "const": "industrial_frontier" },
    "registry_id": { "const": "industrial_frontier:m2/worldgen_ownership" },
    "status": { "const": "STATIC_COMPLETE_USER_GATE_PENDING" },
    "scope_ru": { "type": "string", "minLength": 1 },
    "ownership_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "resource_class",
          "status",
          "world_impact",
          "canonical_owner_domain_ref",
          "canonical_owner_mod_ids",
          "disabled_provider_mod_ids",
          "future_provider_labels",
          "scope_dimensions",
          "decision_ru",
          "implementation_checks",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^industrial_frontier:worldgen/[a-z0-9_/-]+$"
          },
          "resource_class": {
            "enum": [
              "GEOLOGICAL_ORES",
              "VANILLA_ORES",
              "ZINC_ORE",
              "UNIQUE_STRUCTURE",
              "ATOMIC_FEEDSTOCK_ORES",
              "PLANETARY_RESOURCES"
            ]
          },
          "status": {
            "enum": [
              "ACTIVE_CONFIGURED",
              "DISABLED_DUPLICATE",
              "PRESERVED_UNIQUE",
              "STATIC_POLICY_DECIDED_USER_TEST_PENDING",
              "GATED_NOT_INSTALLED",
              "OPEN_STATIC_AUDIT"
            ]
          },
          "world_impact": { "const": true },
          "canonical_owner_domain_ref": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
          "canonical_owner_mod_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
            "uniqueItems": true
          },
          "disabled_provider_mod_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
            "uniqueItems": true
          },
          "future_provider_labels": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "scope_dimensions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "decision_ru": { "type": "string", "minLength": 1 },
          "implementation_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "key_or_resource", "expected", "status"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "key_or_resource": { "type": "string", "minLength": 1 },
                "expected": { "type": "string", "minLength": 1 },
                "status": { "enum": ["STATIC_CONFIRMED", "GATED_NOT_INSTALLED", "OPEN_AUDIT"] }
              }
            }
          },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "m2_common.schema.json#/$defs/gate" }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "m2_common.schema.json#/$defs/sourceEvidence" }
    }
  }
}
