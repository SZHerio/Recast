{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/m2_progression_graph.schema.json",
  "title": "Recast M2 P0-P9 progression graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "registry_id",
    "status",
    "scope_ru",
    "authority",
    "proof_priority",
    "nodes",
    "dependency_edges",
    "production_edges",
    "bounded_recycle_edges",
    "edges",
    "gates",
    "source_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "namespace": { "const": "industrial_frontier" },
    "registry_id": { "const": "industrial_frontier:m2/progression_graph" },
    "status": { "const": "STATIC_COMPLETE_USER_GATE_PENDING" },
    "scope_ru": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "minimum",
        "maximum",
        "storage_owner",
        "runtime_status",
        "read_only_mirrors",
        "forbidden_authorities",
        "evidence_refs",
        "gate_refs"
      ],
      "properties": {
        "parameter_id": { "const": "industrial_frontier:tech_epoch" },
        "minimum": { "const": 0 },
        "maximum": { "const": 9 },
        "storage_owner": { "const": "Threat Director" },
        "runtime_status": { "const": "DESIGN_ONLY_NOT_IMPLEMENTED" },
        "read_only_mirrors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbidden_authorities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
        "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
      }
    },
    "proof_priority": {
      "const": [
        "MATERIAL_CHAIN",
        "INFRASTRUCTURE_OR_THROUGHPUT",
        "MACHINE_OR_PHYSICAL_CONDITION",
        "ENVIRONMENT",
        "QUEST_LICENSE_ONLY"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "epoch",
          "title_ru",
          "title_en",
          "status",
          "fantasy_ru",
          "required_outcome_ru",
          "installed_domain_refs",
          "gated_domain_refs",
          "canonical_proofs",
          "contract_refs",
          "required_substance_refs",
          "infrastructure_refs",
          "extended_refs",
          "grind_chain_refs",
          "critical_component_refs",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "node_id": { "type": "string", "pattern": "^industrial_frontier:epoch/p[0-9]$" },
          "epoch": { "$ref": "m2_common.schema.json#/$defs/epoch" },
          "title_ru": { "type": "string", "minLength": 1 },
          "title_en": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "DESIGN_BASELINE",
              "GATED_CONTENT_NOT_IMPLEMENTED",
              "GATED_NOT_INSTALLED"
            ]
          },
          "fantasy_ru": { "type": "string", "minLength": 1 },
          "required_outcome_ru": { "type": "string", "minLength": 1 },
          "installed_domain_refs": {
            "type": "array",
            "items": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
            "uniqueItems": true
          },
          "gated_domain_refs": {
            "type": "array",
            "items": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
            "uniqueItems": true
          },
          "canonical_proofs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "MATERIAL_CHAIN",
                "INFRASTRUCTURE_OR_THROUGHPUT",
                "MACHINE_OR_PHYSICAL_CONDITION",
                "ENVIRONMENT",
                "QUEST_LICENSE_ONLY"
              ]
            },
            "uniqueItems": true
          },
          "contract_refs": {
            "type": "array",
            "items": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
            "uniqueItems": true
          },
          "required_substance_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^industrial_frontier:substance/[a-z0-9_/-]+$"
            },
            "uniqueItems": true
          },
          "infrastructure_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
            "uniqueItems": true
          },
          "extended_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^docs/registries/m2_extended_domains\\.json#/[a-z0-9_./?=-]+$"
            },
            "uniqueItems": true
          },
          "grind_chain_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^industrial_frontier:grind/[a-z0-9_./-]+$"
            },
            "uniqueItems": true
          },
          "critical_component_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^industrial_frontier:component/p[0-9]/[a-z0-9_./-]+$"
            },
            "uniqueItems": true
          },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "minItems": 47,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "from_ref",
          "to_ref",
          "relation",
          "status",
          "recipe_policy_pointer",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "pattern": "^industrial_frontier:dependency/e[0-9]{4}$"
          },
          "from_ref": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
          "to_ref": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
          "relation": {
            "enum": [
              "FORM_REPRESENTS_SUBSTANCE",
              "SUBSTANCE_GOVERNED_BY_PROCESS",
              "PROCESS_ENABLES_EPOCH",
              "EPOCH_SERVES_CONSUMER_DOMAIN",
              "COMPONENT_REQUIRES"
            ]
          },
          "status": { "enum": ["STATIC_BINDING", "GATED_BINDING"] },
          "recipe_policy_pointer": {
            "anyOf": [
              { "type": "string", "pattern": "^docs/registries/m2_substance_passports\\.json#/.+/recipe_policy_ru$" },
              { "type": "null" }
            ]
          },
          "direction": {
            "enum": ["REQUIREMENT_TO_COMPONENT"]
          },
          "optionality": {
            "enum": ["REQUIRED", "OPTIONAL"]
          },
          "earliest_epoch": { "$ref": "m2_common.schema.json#/$defs/nullableEpoch" },
          "automation_epoch": { "$ref": "m2_common.schema.json#/$defs/nullableEpoch" },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "production_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "production_edge_id",
          "pathway_ref",
          "stage_ref",
          "from_ref",
          "to_ref",
          "relation",
          "input_group_ref",
          "input_group_logic",
          "direction",
          "optionality",
          "earliest_epoch",
          "automation_epoch",
          "status",
          "owner_domain_ref",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "production_edge_id": { "type": "string", "pattern": "^industrial_frontier:production_edge/pe[0-9]{4}$" },
          "pathway_ref": { "type": "string", "pattern": "^industrial_frontier:pathway/[a-z0-9_/-]+$" },
          "stage_ref": { "type": "string", "pattern": "^industrial_frontier:stage/[a-z0-9_/-]+$" },
          "from_ref": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
          "to_ref": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
          "relation": { "enum": ["PROCESS_CONSUMES", "PROCESS_PRODUCES", "PROCESS_EMITS_WASTE"] },
          "input_group_ref": {
            "anyOf": [
              { "type": "string", "pattern": "^industrial_frontier:input_group/[a-z0-9_/-]+$" },
              { "type": "null" }
            ]
          },
          "input_group_logic": {
            "anyOf": [
              { "enum": ["ALL_OF", "ONE_OF"] },
              { "type": "null" }
            ]
          },
          "direction": { "enum": ["SUBSTANCE_TO_STAGE", "STAGE_TO_SUBSTANCE"] },
          "optionality": { "enum": ["REQUIRED", "OPTIONAL_BYPRODUCT"] },
          "earliest_epoch": { "$ref": "m2_common.schema.json#/$defs/nullableEpoch" },
          "automation_epoch": { "$ref": "m2_common.schema.json#/$defs/nullableEpoch" },
          "status": { "enum": ["STATIC_BINDING", "GATED_BINDING"] },
          "owner_domain_ref": { "type": "string", "pattern": "^industrial_frontier:domain/[a-z0-9_/-]+$" },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "bounded_recycle_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recycle_edge_id",
          "pathway_ref",
          "stage_ref",
          "substance_ref",
          "loop_kind",
          "direction",
          "max_return_ratio",
          "minimum_makeup_ratio",
          "max_consecutive_passes",
          "mass_gain_forbidden",
          "earliest_epoch",
          "automation_epoch",
          "status",
          "owner_domain_ref",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "recycle_edge_id": { "type": "string", "pattern": "^industrial_frontier:recycle_edge/re[0-9]{4}$" },
          "pathway_ref": { "type": "string", "pattern": "^industrial_frontier:pathway/[a-z0-9_/-]+$" },
          "stage_ref": { "type": "string", "pattern": "^industrial_frontier:stage/[a-z0-9_/-]+$" },
          "substance_ref": { "type": "string", "pattern": "^industrial_frontier:substance/[a-z0-9_/-]+$" },
          "loop_kind": { "enum": ["MATERIAL_RECOVERY", "IDENTITY_PRESERVING_FORM"] },
          "direction": { "const": "SUBSTANCE_TO_STAGE_AND_BACK" },
          "max_return_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "minimum_makeup_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
          "max_consecutive_passes": { "type": "integer", "minimum": 1, "maximum": 64 },
          "mass_gain_forbidden": { "const": true },
          "earliest_epoch": { "$ref": "m2_common.schema.json#/$defs/nullableEpoch" },
          "automation_epoch": { "$ref": "m2_common.schema.json#/$defs/nullableEpoch" },
          "status": { "enum": ["STATIC_BINDING", "GATED_BINDING"] },
          "owner_domain_ref": { "type": "string", "pattern": "^industrial_frontier:domain/[a-z0-9_/-]+$" },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from",
          "to",
          "status",
          "required_proof",
          "requirement_ru",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "edge_id": { "$ref": "m2_common.schema.json#/$defs/industrialFrontierId" },
          "from": { "type": "string", "pattern": "^industrial_frontier:epoch/p[0-9]$" },
          "to": { "type": "string", "pattern": "^industrial_frontier:epoch/p[0-9]$" },
          "status": { "enum": ["GATED_NOT_IMPLEMENTED", "BLOCKED_NOT_INSTALLED"] },
          "required_proof": {
            "enum": [
              "MATERIAL_CHAIN",
              "INFRASTRUCTURE_OR_THROUGHPUT",
              "MACHINE_OR_PHYSICAL_CONDITION",
              "ENVIRONMENT",
              "QUEST_LICENSE_ONLY"
            ]
          },
          "requirement_ru": { "type": "string", "minLength": 1 },
          "evidence_refs": { "$ref": "m2_common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "m2_common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "m2_common.schema.json#/$defs/gate" }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "m2_common.schema.json#/$defs/sourceEvidence" }
    }
  }
}
