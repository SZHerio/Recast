{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-frontier.invalid/schemas/material_forms.schema.json",
  "title": "Recast M2 material forms",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "registry_id",
    "status",
    "scope_ru",
    "coverage",
    "forms",
    "gates",
    "source_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "namespace": { "const": "industrial_frontier" },
    "registry_id": { "const": "industrial_frontier:material_forms" },
    "status": { "const": "STATIC_COMPLETE_USER_GATE_PENDING" },
    "scope_ru": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "exhaustive_for",
        "excluded_dynamic_scope",
        "excluded_known_scope",
        "exclusion_reason_ru",
        "required_owner_dump_ru",
        "required_gate_ref"
      ],
      "properties": {
        "claim": { "const": "STATIC_TOUCHED_FORMS_COMPLETE_DYNAMIC_CENSUS_USER_GATE_PENDING" },
        "exhaustive_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded_dynamic_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "excluded_known_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclusion_reason_ru": { "type": "string", "minLength": 1 },
        "required_owner_dump_ru": { "type": "string", "minLength": 1 },
        "required_gate_ref": { "$ref": "common.schema.json#/$defs/industrialFrontierId" }
      }
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "form_id",
          "substance_ref",
          "registry_id",
          "canonical_term_ru",
          "availability",
          "status",
          "form_kind",
          "physical_state",
          "purity_class",
          "owner_domain_ref",
          "forge_tags",
          "input_policy",
          "output_policy",
          "conversion",
          "evidence_refs",
          "gate_refs"
        ],
        "properties": {
          "form_id": {
            "type": "string",
            "pattern": "^industrial_frontier:form/[a-z0-9_/-]+$"
          },
          "substance_ref": {
            "type": "string",
            "pattern": "^industrial_frontier:substance/[a-z0-9_/-]+$"
          },
          "registry_id": {
            "anyOf": [
              { "$ref": "common.schema.json#/$defs/minecraftId" },
              { "type": "null" }
            ]
          },
          "canonical_term_ru": { "type": "string", "minLength": 1 },
          "availability": { "enum": ["INSTALLED", "GATED_NOT_INSTALLED"] },
          "status": {
            "enum": [
              "ACTIVE_INSTALLED",
              "DISABLED_DUPLICATE",
              "AUDIT_REQUIRED",
              "GATED_NOT_INSTALLED"
            ]
          },
          "form_kind": {
            "enum": [
              "ORE",
              "RAW_MATERIAL",
              "INGOT",
              "NUGGET",
              "DUST",
              "PLATE",
              "CRYSTAL",
              "CHARGED_CRYSTAL",
              "BLOCK",
              "FLUID",
              "GAS",
              "SOLUTION",
              "FUEL",
              "SPECIALIZED_COMPONENT"
            ]
          },
          "physical_state": { "enum": ["SOLID", "LIQUID", "GAS", "PLASMA", "MIXTURE", "UNKNOWN"] },
          "purity_class": {
            "enum": [
              "RAW",
              "TECHNICAL",
              "CHEMICAL",
              "ELECTRONIC",
              "REACTOR",
              "AEROSPACE",
              "DOMAIN_SPECIALIZED",
              "UNCLASSIFIED"
            ]
          },
          "owner_domain_ref": { "$ref": "common.schema.json#/$defs/industrialFrontierId" },
          "forge_tags": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/minecraftId" },
            "uniqueItems": true
          },
          "input_policy": {
            "enum": [
              "EXACT_ID_ONLY",
              "TAG_ACCEPTED",
              "DOMAIN_SPECIALIZED",
              "DISABLED",
              "GATED"
            ]
          },
          "output_policy": {
            "enum": [
              "PRESERVE_VENDOR_OUTPUT",
              "CANONICAL_DOMAIN_OUTPUT",
              "INPUT_ONLY",
              "NO_OUTPUT",
              "GATED"
            ]
          },
          "conversion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "target_form_ref", "input_units", "output_units", "material_gain_forbidden"],
            "properties": {
              "mode": { "enum": ["NONE", "ONE_TO_ONE_NO_PROFIT", "GATED_AUDIT"] },
              "target_form_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^industrial_frontier:form/[a-z0-9_/-]+$"
                  },
                  { "type": "null" }
                ]
              },
              "input_units": { "type": ["integer", "null"], "minimum": 1 },
              "output_units": { "type": ["integer", "null"], "minimum": 1 },
              "material_gain_forbidden": { "const": true }
            }
          },
          "evidence_refs": { "$ref": "common.schema.json#/$defs/evidenceRefs" },
          "gate_refs": { "$ref": "common.schema.json#/$defs/gateRefs" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/gate" }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceEvidence" }
    }
  }
}
